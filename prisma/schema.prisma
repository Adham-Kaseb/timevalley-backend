// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                    @id @default(uuid())
  name                String
  email               String                    @unique
  password            String
  role                String                    @default("STUDENT")
  hasDiplomaAccess     Boolean                   @default(false)
  phone               String?
  bio                 String?
  avatar              String?
  studentId           String?
  companyName         String?
  linkedinUrl         String?
  githubUrl           String?
  targetSector        String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  certificates        Certificate[]
  enrollments         Enrollment[]
  adminPermissions    AdminPermission[]
  lessonProgress      StudentLessonProgress[]
  unlockedModules     StudentModuleUnlock[]
  unlockedLessons     StudentLessonUnlock[]
  customAssignments   CustomStudentAssignment[]
  recruitingTeams     RecruitingTeam[]
  teamApplications    TeamApplication[]
  eventRsvps          EventRSVP[]
  resourceDownloads   ResourceDownloadLog[]
  ventureIdeas        VentureIdea[]
  marketCalculations  MarketResearchCalculation[]
  quizResults         StudentQuizResult[]
  paymentTransactions PaymentTransaction[]
  pushSubscriptions   PushSubscription[]
}

model AdminPermission {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionKey String
  createdAt     DateTime @default(now())

  @@unique([userId, permissionKey])
}

model Certificate {
  id            String   @id @default(uuid())
  title         String
  type          String   @default("DIPLOMA")
  courseId      String   @default("venture-architect-diploma")
  code          String   @unique
  issueDate     DateTime @default(now())
  credentialUrl String?
  pdfUrl        String?
  metadata      Json?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([userId, courseId])
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String   @default("venture-architect-diploma")
  pricePaid Float    @default(5000)
  currency  String   @default("LE")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
}

model DiplomaModule {
  id            String                @id @default(uuid())
  moduleNumber  String
  title         String
  badgeTitle    String
  description   String
  objective     String?
  durationHours Int                   @default(15)
  orderIndex    Int                   @default(0)
  isPublished   Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  lessons       DiplomaLesson[]
  resources     ModuleResource[]
  quizzes       ModuleQuiz[]
  moduleUnlocks StudentModuleUnlock[]
}

model DiplomaLesson {
  id             String                  @id @default(uuid())
  moduleId       String
  module         DiplomaModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonNumber   Int
  title          String
  desc           String
  duration       String
  videoUrl       String                  @default("https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4")
  videoProvider  String?                 @default("BUNNY")
  transcript     String?
  articleContent String?
  isFreePreview  Boolean                 @default(false)
  materials      Json?
  orderIndex     Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  progress       StudentLessonProgress[]
  lessonUnlocks  StudentLessonUnlock[]
}

model ModuleResource {
  id          String        @id @default(uuid())
  moduleId    String
  module      DiplomaModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  fileUrl     String
  fileType    String        @default("PDF")
  fileSize    String        @default("1.5 MB")
  description String?
  createdAt   DateTime      @default(now())
}

model ModuleQuiz {
  id           String              @id @default(uuid())
  moduleId     String
  module       DiplomaModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title        String
  passingScore Int                 @default(80)
  questions    Json
  createdAt    DateTime            @default(now())
  quizResults  StudentQuizResult[]
}

model StudentLessonProgress {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId         String
  lesson           DiplomaLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted      Boolean       @default(false)
  watchDurationSec Int           @default(0)
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([userId, lessonId])
}

model StudentModuleUnlock {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId   String
  module     DiplomaModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  unlockedBy String
  notes      String?
  createdAt  DateTime      @default(now())

  @@unique([userId, moduleId])
}

model StudentLessonUnlock {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     DiplomaLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  unlockedBy String
  notes      String?
  createdAt  DateTime      @default(now())

  @@unique([userId, lessonId])
}

model CustomStudentAssignment {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy    String
  title         String
  description   String
  attachmentUrl String?
  dueDate       DateTime?
  status        String    @default("PENDING")
  submissionUrl String?
  feedback      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model RecruitingTeam {
  id           String            @id @default(uuid())
  name         String
  sector       String
  founderId    String?
  founder      User?             @relation(fields: [founderId], references: [id], onDelete: SetNull)
  founderName  String
  description  String
  openRoles    Json
  equitySplit  String
  status       String            @default("ACTIVE")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  applications TeamApplication[]
}

model TeamApplication {
  id          String         @id @default(uuid())
  teamId      String
  team        RecruitingTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  appliedRole String
  coverNote   String?
  status      String         @default("PENDING")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Event {
  id        String      @id @default(uuid())
  title     String
  date      String
  time      String
  location  String
  type      String
  speakers  String
  desc      String
  status    String      @default("RSVP Open")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  rsvps     EventRSVP[]
}

model EventRSVP {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail  String
  ticketCode String   @unique
  createdAt  DateTime @default(now())

  @@unique([eventId, userId])
}

model PublicResource {
  id             String                @id @default(uuid())
  title          String
  category       String
  format         String
  fileUrl        String
  desc           String
  downloadsCount Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  downloads      ResourceDownloadLog[]
}

model ResourceDownloadLog {
  id         String         @id @default(uuid())
  resourceId String
  resource   PublicResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
}

model VentureIdea {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  sector           String
  icpTarget        String
  problemStatement String
  tamEstimate      String
  pitchScore       Int      @default(85)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MarketResearchCalculation {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  tamAmount          String
  samAmount          String
  somAmount          String
  defensibilityScore Int      @default(90)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model StudentQuizResult {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      ModuleQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score     Int
  passed    Boolean    @default(false)
  answers   Json?
  createdAt DateTime   @default(now())

  @@unique([userId, quizId])
}

model PaymentTransaction {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  amount         Float
  currency       String   @default("LE")
  paymentMethod  String
  transactionRef String   @unique
  status         String   @default("SUCCESS")
  createdAt      DateTime @default(now())
}

model NewsletterSubscription {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  type      String   @default("CONTACT")
  createdAt DateTime @default(now())
}

model Coupon {
  id                 String    @id @default(uuid())
  code               String    @unique
  discountType       String    @default("FIXED") // FIXED or PERCENTAGE
  discountValue      Float     @default(500)
  minPurchaseAmount  Float     @default(0)
  validFrom          DateTime  @default(now())
  validUntil         DateTime?
  maxRedemptions     Int?      // null = unlimited
  timesRedeemed      Int       @default(0)
  allowStacking      Boolean   @default(false)
  applicableScope    String    @default("DIPLOMA")
  status             String    @default("ACTIVE") // ACTIVE, DISABLED, EXPIRED
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  code      String   // 6-digit OTP code
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model ConsultationCard {
  id               String   @id @default(uuid())
  title            String
  consultantName   String   @default("Dr. Wael")
  consultantTitle  String   @default("Founder & Managing Partner")
  consultantAvatar String?
  category         String   @default("Venture Strategy")
  description      String
  duration         String   @default("45 Mins")
  price            Float    @default(0)
  currency         String   @default("USD")
  bookingUrl       String?
  tags             Json?
  isPublished      Boolean  @default(true)
  orderIndex       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PushNotificationLog {
  id         String   @id @default(uuid())
  title      String
  body       String
  targetUrl  String?
  sentBy     String
  recipients Int      @default(0)
  status     String   @default("SENT")
  createdAt  DateTime @default(now())
}

